FROM ros:humble-ros-base

SHELL ["/bin/bash", "-lc"]

WORKDIR /app

# Python deps for the orchestrator server
COPY requirements.txt ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir -r requirements.txt

COPY . .

ENV ROS_ENABLED=true \
    ROS_NODE_NAME=orchestrator_bridge \
    ROS_DISCOVERY_PERIOD_SEC=1.0 \
    WS_HOST=0.0.0.0 \
    WS_PORT=8080 \
    API_HOST=0.0.0.0 \
    API_PORT=8090 \
    PYTHONUNBUFFERED=1

EXPOSE 8080 8090

CMD source /opt/ros/humble/setup.bash && exec python3 -u main.py
